{
  "manifest_version": 3,
  "name": "InsightTab",
  "version": "1.1.0",
  "description": "AI-assisted content analysis and insights in the browser",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}